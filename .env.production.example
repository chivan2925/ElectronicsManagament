# ElectronicsManagement production environment template.
# Copy to your deployment secret store or a local `.env.production` file.
# Keep real secrets out of git.

COMPOSE_PROJECT_NAME=electronics-management

# Postgres
POSTGRES_IMAGE_TAG=18-alpine
POSTGRES_DB=electronics_management
POSTGRES_USER=electronics
POSTGRES_PASSWORD=replace-with-production-postgres-password
POSTGRES_PORT=5432

# Backend runtime
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
CORS_ALLOWED_ORIGIN_PATTERNS=https://your-domain.example
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# Database connection used by the backend container.
DB_URL=jdbc:postgresql://postgres:5432/electronics_management
DB_USERNAME=electronics
DB_PASSWORD=replace-with-production-postgres-password

# JWT
ELECTRONICS_JWT_SECRET=replace-with-at-least-32-random-bytes
ELECTRONICS_JWT_EXPIRATION_MS=86400000

# Public frontend URLs used in payment redirects.
PAYMENT_FRONTEND_SUCCESS_URL=https://your-domain.example/payment/success
PAYMENT_FRONTEND_FAILED_URL=https://your-domain.example/payment/failed

# VNPay production credentials and endpoints.
VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
VNPAY_SECRET_KEY=replace-with-vnpay-secret-key
VNPAY_PAY_URL=https://replace-with-vnpay-production-pay-url
VNPAY_REFUND_URL=https://replace-with-vnpay-production-refund-url
VNPAY_RETURN_URL=https://api.your-domain.example/api/payments/vnpay-return

# MoMo production credentials and endpoints.
MOMO_PARTNER_CODE=replace-with-momo-partner-code
MOMO_ACCESS_KEY=replace-with-momo-access-key
MOMO_SECRET_KEY=replace-with-momo-secret-key
MOMO_ENDPOINT=https://replace-with-momo-production-create-url
MOMO_REFUND_URL=https://replace-with-momo-production-refund-url
MOMO_RETURN_URL=https://api.your-domain.example/api/payments/momo-return
MOMO_NOTIFY_URL=https://api.your-domain.example/api/system/payment/momo-ipn

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Frontend production image build.
FRONTEND_PORT=8088
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000
VITE_SITE_URL=https://your-domain.example
VITE_OG_IMAGE_URL=https://your-domain.example/og-image.png
VITE_APP_VERSION=local
VITE_BUILD_SOURCEMAP=false
VITE_ENABLE_CLIENT_MONITORING=true
VITE_ENABLE_CLIENT_LOGS=false
VITE_MONITOR_ROUTE_CHANGES=false
VITE_AUTH_TOKEN_STORAGE=session
VITE_AUTH_REFRESH_ENDPOINT=/admin/auth/refresh
VITE_DEMO_MODE=false
VITE_PRODUCT_API_PATH=/admin/products
VITE_COUPON_API_PATH=/admin/coupons
VITE_ORDER_API_PATH=/orders
VITE_PAYMENT_API_PATH=/payments
VITE_REALTIME_WS_URL=
VITE_USER_API_PATH=/admin/users
VITE_USER_PROFILE_API_PATH=/users
VITE_USER_ORDER_API_PATH=/orders
VITE_WISHLIST_API_PATH=
