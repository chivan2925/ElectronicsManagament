# ElectronicsManagement Docker environment template.
# Copy this file to `.env` for local Docker usage. Keep real secrets out of git.

COMPOSE_PROJECT_NAME=electronics-management

# Postgres
POSTGRES_IMAGE_TAG=18-alpine
POSTGRES_DB=electronics_management
POSTGRES_USER=electronics
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_PORT=5432

# Backend container
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8088,http://localhost:5173,http://127.0.0.1:8088,http://127.0.0.1:5173
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# JWT
ELECTRONICS_JWT_SECRET=replace-with-at-least-32-random-bytes
ELECTRONICS_JWT_EXPIRATION_MS=86400000

# Public frontend URLs used in payment redirects.
PAYMENT_FRONTEND_SUCCESS_URL=http://localhost:8088/payment/success
PAYMENT_FRONTEND_FAILED_URL=http://localhost:8088/payment/failed
PAYMENT_DEV_FRONTEND_SUCCESS_URL=http://localhost:5173/payment/success
PAYMENT_DEV_FRONTEND_FAILED_URL=http://localhost:5173/payment/failed

# VNPay sandbox placeholders. Replace per environment.
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_SECRET_KEY=YOUR_SECRET_KEY
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay-return

# MoMo sandbox placeholders. Replace per environment.
MOMO_PARTNER_CODE=MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_URL=https://test-payment.momo.vn/v2/gateway/api/refund
MOMO_RETURN_URL=http://localhost:8080/api/payments/momo-return
MOMO_NOTIFY_URL=http://localhost:8080/api/system/payment/momo-ipn

# Cloudinary placeholders. Leave blank unless media upload is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend production image build.
FRONTEND_PORT=8088
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000
VITE_SITE_URL=http://localhost:8088
VITE_OG_IMAGE_URL=
VITE_APP_VERSION=local
VITE_BUILD_SOURCEMAP=false
VITE_ENABLE_CLIENT_MONITORING=true
VITE_ENABLE_CLIENT_LOGS=false
VITE_MONITOR_ROUTE_CHANGES=false
VITE_AUTH_TOKEN_STORAGE=session
VITE_AUTH_REFRESH_ENDPOINT=/admin/auth/refresh
VITE_DEMO_MODE=false
VITE_PRODUCT_API_PATH=/admin/products
VITE_COUPON_API_PATH=/admin/coupons
VITE_ORDER_API_PATH=/orders
VITE_PAYMENT_API_PATH=/payments
VITE_REALTIME_WS_URL=
VITE_USER_API_PATH=/admin/users
VITE_USER_PROFILE_API_PATH=/users
VITE_USER_ORDER_API_PATH=/orders
VITE_WISHLIST_API_PATH=/wishlist

# Frontend development compose override.
FRONTEND_DEV_PORT=5173
VITE_DEV_API_BASE_URL=http://localhost:8080/api
VITE_DEV_SITE_URL=http://localhost:5173
