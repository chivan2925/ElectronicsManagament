# ElectronicsManagement frontend production environment template.
# Copy to `.env.production` during deployment and keep real values out of git.

VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000
VITE_SITE_URL=https://your-domain.example
VITE_OG_IMAGE_URL=https://your-domain.example/og-image.png
VITE_APP_VERSION=local
VITE_BUILD_SOURCEMAP=false
VITE_ENABLE_CLIENT_MONITORING=true
VITE_ENABLE_CLIENT_LOGS=false
VITE_MONITOR_ROUTE_CHANGES=false
VITE_AUTH_TOKEN_STORAGE=session
VITE_AUTH_REFRESH_ENDPOINT=/admin/auth/refresh
VITE_DEMO_MODE=false
VITE_PRODUCT_API_PATH=/admin/products
VITE_COUPON_API_PATH=/admin/coupons
VITE_ORDER_API_PATH=/orders
VITE_PAYMENT_API_PATH=/payments
VITE_REALTIME_WS_URL=
VITE_USER_API_PATH=/admin/users
VITE_USER_PROFILE_API_PATH=/users
VITE_USER_ORDER_API_PATH=/orders
VITE_WISHLIST_API_PATH=/wishlist
