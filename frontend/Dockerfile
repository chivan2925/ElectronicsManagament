# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base
WORKDIR /app
ENV npm_config_update_notifier=false

COPY package*.json ./

FROM base AS deps
RUN npm ci

FROM deps AS development
ENV NODE_ENV=development
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

FROM deps AS build
ARG VITE_API_BASE_URL=/api
ARG VITE_API_TIMEOUT=15000
ARG VITE_AUTH_TOKEN_STORAGE=session
ARG VITE_AUTH_REFRESH_ENDPOINT=/admin/auth/refresh
ARG VITE_PRODUCT_API_PATH=/admin/products
ARG VITE_COUPON_API_PATH=/admin/coupons
ARG VITE_ORDER_API_PATH=/orders
ARG VITE_PAYMENT_API_PATH=/payments
ARG VITE_REALTIME_WS_URL=
ARG VITE_USER_API_PATH=/admin/users
ARG VITE_USER_PROFILE_API_PATH=/users
ARG VITE_USER_ORDER_API_PATH=/orders
ARG VITE_WISHLIST_API_PATH=/wishlist

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_TIMEOUT=$VITE_API_TIMEOUT
ENV VITE_AUTH_TOKEN_STORAGE=$VITE_AUTH_TOKEN_STORAGE
ENV VITE_AUTH_REFRESH_ENDPOINT=$VITE_AUTH_REFRESH_ENDPOINT
ENV VITE_PRODUCT_API_PATH=$VITE_PRODUCT_API_PATH
ENV VITE_COUPON_API_PATH=$VITE_COUPON_API_PATH
ENV VITE_ORDER_API_PATH=$VITE_ORDER_API_PATH
ENV VITE_PAYMENT_API_PATH=$VITE_PAYMENT_API_PATH
ENV VITE_REALTIME_WS_URL=$VITE_REALTIME_WS_URL
ENV VITE_USER_API_PATH=$VITE_USER_API_PATH
ENV VITE_USER_PROFILE_API_PATH=$VITE_USER_PROFILE_API_PATH
ENV VITE_USER_ORDER_API_PATH=$VITE_USER_ORDER_API_PATH
ENV VITE_WISHLIST_API_PATH=$VITE_WISHLIST_API_PATH

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS production
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
